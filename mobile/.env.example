# Copy to `.env` in this folder. Do not commit `.env` (it is gitignored).
#
# Physical device / Expo Go must reach your dev machine over the network:
#   EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:3000
# With Tailscale, you can use the hostname from the Tailscale admin dashboard:
#   EXPO_PUBLIC_API_URL=http://<your-machine>.tailscale.net:3000
#
# iOS Simulator (Mac): http://127.0.0.1:3000
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
